# LLM 配置模板 —— 复制为 llm.toml 并填入你的 API Key
# （llm.toml 已在 .gitignore 中，不会被提交）

[llm]
# DeepSeek 官方 OpenAI 兼容端点
base_url = "https://api.deepseek.com"
model = "deepseek-chat"
api_key = ""

# 其他 OpenAI 兼容服务示例：
# OpenAI:   base_url = "https://api.openai.com/v1"  model = "gpt-4o-mini"
# 本地:     base_url = "http://127.0.0.1:11434/v1"  model = "qwen2.5-coder"
